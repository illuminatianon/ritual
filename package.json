{
  "name": "ritual",
  "version": "1.0.0",
  "private": true,
  "description": "Electron, Vue 3, TypeScript, and CodeMirror desktop app.",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc -p packages/frontend/tsconfig.json --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "electron:dev": "vite --host 127.0.0.1",
    "electron:build": "pnpm build && electron-builder --linux AppImage",
    "electron:build:linux": "pnpm build && electron-builder --linux AppImage",
    "test": "TMPDIR=/tmp vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.18.2",
  "dependencies": {
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.38.4",
    "@ritual/backend": "workspace:*",
    "@ritual/frontend": "workspace:*",
    "better-sqlite3": "^12.4.6",
    "diff": "^8.0.2",
    "pinia": "^3.0.4",
    "syllable-engine": "workspace:*",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/diff": "^7.0.2",
    "@types/node": "^24.7.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "^38.4.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.0.16",
    "vue-tsc": "^3.1.1"
  },
  "build": {
    "appId": "dev.lumi.ritual",
    "productName": "Ritual",
    "files": [
      "dist",
      "dist-electron"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    }
  }
}
