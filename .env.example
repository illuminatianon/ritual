# Local PostgreSQL runs with docker compose.
DATABASE_URL=postgresql://ritual:ritual_dev@127.0.0.1:5432/ritual

# Use a long random value (at least 32 characters) outside development.
NUXT_SESSION_PASSWORD=replace-with-a-long-random-secret
NUXT_OAUTH_GOOGLE_CLIENT_ID=replace-with-google-client-id
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
NUXT_OAUTH_GOOGLE_REDIRECT_URL=http://localhost:3000/auth/google

# allowlist, open, or closed
NUXT_RITUAL_AUTH_MODE=allowlist
NUXT_RITUAL_ALLOWED_EMAILS=

# Production-only process settings. Do not add NODE_ENV=production to local .env.
# NODE_ENV=production
# HOST=127.0.0.1
# PORT=3000
