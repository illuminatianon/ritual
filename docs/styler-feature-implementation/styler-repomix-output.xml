<file path="server/index.ts">
import 'dotenv/config'
import Database from 'better-sqlite3'
import express, { type NextFunction, type Request, type Response } from 'express'
import { mkdirSync } from 'node:fs'
import path from 'node:path'
import { fileURLToPath } from 'node:url'

const __dirname = path.dirname(fileURLToPath(import.meta.url))
const dataDirectory = path.resolve(__dirname, '../data')
mkdirSync(dataDirectory, { recursive: true })
const db = new Database(path.join(dataDirectory, 'styler.db'))
db.pragma('journal_mode = WAL')
db.pragma('foreign_keys = ON')

db.exec(`
  CREATE TABLE IF NOT EXISTS styles (
    id INTEGER PRIMARY KEY,
    name TEXT NOT NULL,
    current_version_id INTEGER,
    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    deleted_at TEXT
  );
  CREATE TABLE IF NOT EXISTS style_versions (
    id INTEGER PRIMARY KEY,
    style_id INTEGER NOT NULL REFERENCES styles(id),
    version_number INTEGER NOT NULL,
    positive_prompt TEXT NOT NULL,
    negative_prompt TEXT NOT NULL,
    metadata_json TEXT NOT NULL DEFAULT '{}',
    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(style_id, version_number)
  );
  CREATE INDEX IF NOT EXISTS styles_active_updated_idx ON styles(deleted_at, updated_at DESC);
  CREATE INDEX IF NOT EXISTS style_versions_style_idx ON style_versions(style_id, version_number DESC);
`)

type StyleInput = {
  name?: unknown
  positivePrompt?: unknown
  negativePrompt?: unknown
  metadata?: unknown
  source?: unknown
}

const MAX_POSITIVE_LENGTH = 1000
const MAX_NEGATIVE_LENGTH = 1000

function requireText(value: unknown, field: string, maxLength: number) {
  if (typeof value !== 'string' || !value.trim()) throw new Error(`${field} is required.`)
  const text = value.trim()
  if (text.length > maxLength) throw new Error(`${field} must be ${maxLength} characters or fewer.`)
  return text
}

function normalizeInput(input: StyleInput) {
  const name = requireText(input.name, 'Name', 120)
  const positivePrompt = requireText(input.positivePrompt, 'Positive prompt', MAX_POSITIVE_LENGTH)
  const negativePrompt = typeof input.negativePrompt === 'string' ? input.negativePrompt.trim() : ''
  if (negativePrompt.length > MAX_NEGATIVE_LENGTH) {
    throw new Error(`Negative prompt must be ${MAX_NEGATIVE_LENGTH} characters or fewer.`)
  }
  const metadata = {
    source: typeof input.source === 'string' ? input.source : 'manual',
    ...(input.metadata && typeof input.metadata === 'object' && !Array.isArray(input.metadata) ? input.metadata : {}),
  }
  return { name, positivePrompt, negativePrompt, metadata: JSON.stringify(metadata) }
}

function styleSummary(id: number) {
  return db.prepare(`
    SELECT s.id, s.name, s.current_version_id AS currentVersionId, s.created_at AS createdAt,
      s.updated_at AS updatedAt, sv.version_number AS versionNumber,
      sv.positive_prompt AS positivePrompt, sv.negative_prompt AS negativePrompt,
      sv.metadata_json AS metadataJson, sv.created_at AS versionCreatedAt
    FROM styles s
    JOIN style_versions sv ON sv.id = s.current_version_id
    WHERE s.id = ? AND s.deleted_at IS NULL
  `).get(id)
}

const insertStyle = db.prepare('INSERT INTO styles (name) VALUES (?)')
const insertVersion = db.prepare(`
  INSERT INTO style_versions (style_id, version_number, positive_prompt, negative_prompt, metadata_json)
  VALUES (?, ?, ?, ?, ?)
`)
const setCurrentVersion = db.prepare(`
  UPDATE styles SET current_version_id = ?, updated_at = CURRENT_TIMESTAMP WHERE id = ?
`)

function createStyle(input: StyleInput) {
  const values = normalizeInput(input)
  return db.transaction(() => {
    const styleId = Number(insertStyle.run(values.name).lastInsertRowid)
    const versionId = Number(insertVersion.run(styleId, 1, values.positivePrompt, values.negativePrompt, values.metadata).lastInsertRowid)
    setCurrentVersion.run(versionId, styleId)
    return styleSummary(styleId)
  })()
}

function createVersion(styleId: number, input: StyleInput) {
  const values = normalizeInput(input)
  return db.transaction(() => {
    const style = db.prepare('SELECT id FROM styles WHERE id = ? AND deleted_at IS NULL').get(styleId)
    if (!style) throw new Error('Style not found.')
    const nextVersionStatement = db.prepare<[number], { version: number }>('SELECT COALESCE(MAX(version_number), 0) + 1 AS version FROM style_versions WHERE style_id = ?')
    const nextVersionResult = nextVersionStatement.get(styleId)
    if (!nextVersionResult) throw new Error('Could not allocate a style version.')
    const nextVersion = nextVersionResult.version
    const versionId = Number(insertVersion.run(styleId, nextVersion, values.positivePrompt, values.negativePrompt, values.metadata).lastInsertRowid)
    db.prepare('UPDATE styles SET name = ?, current_version_id = ?, updated_at = CURRENT_TIMESTAMP WHERE id = ?').run(values.name, versionId, styleId)
    return styleSummary(styleId)
  })()
}

function parseGeneratedPrompts(content: string) {
  const match = content.match(/STYLE\s*PROMPT\s*:\s*([\s\S]*?)\s*NEGATIVE\s*PROMPT\s*:\s*([\s\S]*)/i)
  if (!match) throw new Error('The model returned an unexpected format. Please reroll.')
  const positivePrompt = match[1].trim().replace(/^```[\w-]*|```$/g, '').trim()
  const negativePrompt = match[2].trim().replace(/^```[\w-]*|```$/g, '').trim()
  if (!positivePrompt || positivePrompt.length > MAX_POSITIVE_LENGTH || negativePrompt.length > MAX_NEGATIVE_LENGTH) {
    throw new Error('The generated prompts exceeded the allowed length. Please reroll.')
  }
  return { positivePrompt, negativePrompt }
}

const STYLE_PROMPT_GUIDANCE = `Create original Suno v5.5 style prompts. Keep the Style Prompt and Negative Prompt separate. Style prompts must be 250–700 characters and never exceed ${MAX_POSITIVE_LENGTH}; front-load genre and mood, then vocal delivery, instrumentation, tempo/key, arrangement, production, and mix. Use concise natural phrases. Negative prompts should be concise, specific exclusions and never exceed ${MAX_NEGATIVE_LENGTH}. Never include artists, bands, songs, albums, copyrighted lyrics, voice imitation, or phrases such as "in the style of". Translate references into neutral musical traits. Keep the result original and non-contradictory.`

type OpenRouterPayload = {
  choices?: Array<{ message?: { content?: string } }>
  error?: { message?: string }
}

async function requestStylePrompts(systemInstruction: string, request: string) {
  const apiKey = process.env.OPENROUTER_API_KEY
  if (!apiKey) throw new Error('OPENROUTER_API_KEY is not configured in .env.')

  const response = await fetch('https://openrouter.ai/api/v1/chat/completions', {
    method: 'POST',
    signal: AbortSignal.timeout(45_000),
    headers: {
      Authorization: `Bearer ${apiKey}`,
      'Content-Type': 'application/json',
      ...(process.env.OPENROUTER_SITE_URL ? { 'HTTP-Referer': process.env.OPENROUTER_SITE_URL } : {}),
      ...(process.env.OPENROUTER_APP_NAME ? { 'X-Title': process.env.OPENROUTER_APP_NAME } : {}),
    },
    body: JSON.stringify({
      model: process.env.OPENROUTER_MODEL ?? 'deepseek/deepseek-v4-pro',
      temperature: 0.9,
      messages: [
        { role: 'system', content: `${systemInstruction}\n\n${STYLE_PROMPT_GUIDANCE}\n\nReturn exactly two labeled fields and no commentary:\nSTYLE PROMPT: <positive prompt>\nNEGATIVE PROMPT: <negative prompt>` },
        { role: 'user', content: request },
      ],
    }),
  })

  const payload: OpenRouterPayload = await response.json()
  if (!response.ok) throw new Error(payload.error?.message ?? 'OpenRouter request failed.')
  const content = payload.choices?.[0]?.message?.content
  if (!content) throw new Error('OpenRouter returned no generated prompt.')
  return parseGeneratedPrompts(content)
}

const app = express()
app.use(express.json({ limit: '64kb' }))

app.get('/api/health', (_req, res) => res.json({ ok: true }))

app.get('/api/styles', (_req, res) => {
  const styles = db.prepare(`
    SELECT s.id, s.name, s.current_version_id AS currentVersionId, s.created_at AS createdAt,
      s.updated_at AS updatedAt, sv.version_number AS versionNumber,
      sv.positive_prompt AS positivePrompt, sv.negative_prompt AS negativePrompt,
      sv.metadata_json AS metadataJson, sv.created_at AS versionCreatedAt
    FROM styles s
    JOIN style_versions sv ON sv.id = s.current_version_id
    WHERE s.deleted_at IS NULL
    ORDER BY s.updated_at DESC, s.id DESC
  `).all()
  res.json(styles)
})

app.get('/api/styles/:id', (req, res) => {
  const id = Number(req.params.id)
  const style = styleSummary(id)
  if (!style) return res.status(404).json({ error: 'Style not found.' })
  const versions = db.prepare(`
    SELECT id, version_number AS versionNumber, positive_prompt AS positivePrompt,
      negative_prompt AS negativePrompt, metadata_json AS metadataJson, created_at AS createdAt
    FROM style_versions WHERE style_id = ? ORDER BY version_number DESC
  `).all(id)
  res.json({ ...style, versions })
})

app.post('/api/styles', (req, res) => res.status(201).json(createStyle(req.body)))

app.post('/api/styles/:id/versions', (req, res) => {
  const style = createVersion(Number(req.params.id), req.body)
  res.status(201).json(style)
})

app.delete('/api/styles/:id', (req, res) => {
  const result = db.prepare(`
    UPDATE styles SET deleted_at = CURRENT_TIMESTAMP, updated_at = CURRENT_TIMESTAMP
    WHERE id = ? AND deleted_at IS NULL
  `).run(Number(req.params.id))
  if (!result.changes) return res.status(404).json({ error: 'Style not found.' })
  res.status(204).end()
})

app.post('/api/generate', async (req, res) => {
  const request = requireText(req.body?.request, 'Style request', 2000)
  const prompts = await requestStylePrompts('You create a new style prompt from the user’s requested sound.', request)
  res.json(prompts)
})

app.post('/api/edit-style', async (req, res) => {
  const instruction = requireText(req.body?.instruction, 'Edit request', 2000)
  const positivePrompt = requireText(req.body?.positivePrompt, 'Positive prompt', MAX_POSITIVE_LENGTH)
  const negativePrompt = typeof req.body?.negativePrompt === 'string' ? req.body.negativePrompt.trim() : ''
  if (negativePrompt.length > MAX_NEGATIVE_LENGTH) {
    throw new Error(`Negative prompt must be ${MAX_NEGATIVE_LENGTH} characters or fewer.`)
  }

  const prompts = await requestStylePrompts(
    'You revise an existing Suno style prompt. Apply the requested change while preserving compatible useful direction from the current prompts. If the current prompt or edit request names an artist, band, song, album, or voice, remove that reference and express only neutral musical traits. Do not mention that you removed or cannot use a reference.',
    `CURRENT STYLE PROMPT:\n${positivePrompt}\n\nCURRENT NEGATIVE PROMPT:\n${negativePrompt || '(none)'}\n\nEDIT REQUEST:\n${instruction}`,
  )
  res.json(prompts)
})

app.use(express.static(path.resolve(__dirname, '../dist')))
app.get(/^(?!\/api).*/, (_req, res) => res.sendFile(path.resolve(__dirname, '../dist/index.html')))

app.use((error: unknown, _req: Request, res: Response, _next: NextFunction) => {
  console.error(error)
  const message = error instanceof Error ? error.message : 'Unexpected server error.'
  res.status(message === 'Style not found.' ? 404 : 400).json({ error: message })
})

const port = Number(process.env.PORT ?? 5174)
app.listen(port, () => console.log(`Styler API listening on http://localhost:${port}`))
