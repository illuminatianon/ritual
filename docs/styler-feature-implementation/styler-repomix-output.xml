<script setup lang="ts">
import { computed, onMounted, ref } from 'vue'

type StyleSummary = {
  id: number
  name: string
  currentVersionId: number
  createdAt: string
  updatedAt: string
  versionNumber: number
  positivePrompt: string
  negativePrompt: string
  metadataJson: string
  versionCreatedAt: string
}

type StyleVersion = {
  id: number
  versionNumber: number
  positivePrompt: string
  negativePrompt: string
  metadataJson: string
  createdAt: string
}

type StyleDetail = StyleSummary & { versions: StyleVersion[] }
type PromptDraft = { name: string; positivePrompt: string; negativePrompt: string; source: string }
type GeneratedPrompt = { positivePrompt: string; negativePrompt: string; request: string }

const MAX_POSITIVE = 1000
const MAX_NEGATIVE = 1000
const styles = ref<StyleSummary[]>([])
const selectedId = ref<number | null>(null)
const selectedStyle = ref<StyleDetail | null>(null)
const selectedVersionId = ref<number | null>(null)
const loading = ref(true)
const saving = ref(false)
const error = ref('')
const snackbar = ref(false)
const snackbarText = ref('')

const importDialog = ref(false)
const importText = ref('')
const importName = ref('')
const importResult = ref<{ positivePrompt: string; negativePrompt: string } | null>(null)

const editorDialog = ref(false)
const editorMode = ref<'new' | 'version'>('new')
const draft = ref<PromptDraft>(emptyDraft())

const generateDialog = ref(false)
const generationRequest = ref('')
const generating = ref(false)
const generatedHistory = ref<GeneratedPrompt[]>([])

const modelEditDialog = ref(false)
const modelEditInstruction = ref('')
const editingWithModel = ref(false)
const savingModelEdit = ref(false)
const modelEditHistory = ref<GeneratedPrompt[]>([])

const activeVersion = computed(() =>
  selectedStyle.value?.versions.find((version) => version.id === selectedVersionId.value) ?? selectedStyle.value?.versions[0] ?? null,
)

const versionChoices = computed(() =>
  selectedStyle.value?.versions.map((version) => ({
    title: `Version ${version.versionNumber} · ${formatDate(version.createdAt)}`,
    value: version.id,
  })) ?? [],
)

function emptyDraft(): PromptDraft {
  return { name: '', positivePrompt: '', negativePrompt: '', source: 'manual' }
}

function formatDate(value: string) {
  return new Intl.DateTimeFormat(undefined, { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' }).format(new Date(`${value}Z`))
}

function metadataFor(version: StyleVersion | StyleSummary | null) {
  if (!version) return 'manual'
  try {
    return (JSON.parse(version.metadataJson) as { source?: string }).source ?? 'manual'
  } catch {
    return 'manual'
  }
}

function tell(message: string) {
  snackbarText.value = message
  snackbar.value = true
}

async function api<T>(url: string, options?: RequestInit): Promise<T> {
  const response = await fetch(url, {
    headers: { 'Content-Type': 'application/json', ...(options?.headers ?? {}) },
    ...options,
  })
  if (!response.ok) {
    const payload = await response.json().catch(() => ({ error: 'Request failed.' })) as { error?: string }
    throw new Error(payload.error ?? 'Request failed.')
  }
  return response.status === 204 ? (undefined as T) : response.json() as Promise<T>
}

async function loadStyles(selectFirst = false) {
  styles.value = await api<StyleSummary[]>('/api/styles')
  if (selectFirst && styles.value.length) await selectStyle(styles.value[0].id)
}

async function selectStyle(id: number) {
  error.value = ''
  selectedId.value = id
  try {
    const detail = await api<StyleDetail>(`/api/styles/${id}`)
    selectedStyle.value = detail
    selectedVersionId.value = detail.currentVersionId
  } catch (caught) {
    error.value = caught instanceof Error ? caught.message : 'Could not load style.'
  }
}

function openNewStyle() {
  editorMode.value = 'new'
  draft.value = emptyDraft()
  editorDialog.value = true
}

function openImport() {
  importResult.value = null
  importDialog.value = true
}

function cancelImport() {
  importText.value = ''
  importName.value = ''
  importResult.value = null
  importDialog.value = false
}

function openVersionEditor() {
  if (!selectedStyle.value || !activeVersion.value) return
  editorMode.value = 'version'
  draft.value = {
    name: selectedStyle.value.name,
    positivePrompt: activeVersion.value.positivePrompt,
    negativePrompt: activeVersion.value.negativePrompt,
    source: 'manual',
  }
  editorDialog.value = true
}

async function saveDraft() {
  if (!draft.value.name.trim() || !draft.value.positivePrompt.trim()) {
    error.value = 'A name and positive prompt are required.'
    return
  }
  saving.value = true
  error.value = ''
  try {
    const endpoint = editorMode.value === 'new' ? '/api/styles' : `/api/styles/${selectedStyle.value?.id}/versions`
    const method = 'POST'
    const style = await api<StyleSummary>(endpoint, { method, body: JSON.stringify(draft.value) })
    editorDialog.value = false
    await loadStyles()
    await selectStyle(style.id)
    tell(editorMode.value === 'new' ? 'Style saved.' : 'New version saved.')
  } catch (caught) {
    error.value = caught instanceof Error ? caught.message : 'Could not save style.'
  } finally {
    saving.value = false
  }
}

function parseImport() {
  const chunks = importText.value.split(',').map((part) => part.trim()).filter(Boolean)
  const negative: string[] = []
  const positive: string[] = []
  for (const chunk of chunks) {
    if (/^[\-‐‑‒–—]\s*/.test(chunk)) negative.push(chunk.replace(/^[\-‐‑‒–—]\s*/, '').trim())
    else positive.push(chunk)
  }
  importResult.value = {
    positivePrompt: positive.join(', '),
    negativePrompt: negative.map((term) => `no ${term}`).join(', '),
  }
  if (!importName.value.trim()) importName.value = positive[0]?.slice(0, 60) ?? ''
}

async function saveImported() {
  if (!importResult.value) return
  draft.value = {
    name: importName.value,
    positivePrompt: importResult.value.positivePrompt,
    negativePrompt: importResult.value.negativePrompt,
    source: 'import',
  }
  editorMode.value = 'new'
  importDialog.value = false
  await saveDraft()
}

async function copy(text: string, label: string) {
  try {
    await navigator.clipboard.writeText(text)
    tell(`${label} copied.`)
  } catch {
    tell('Clipboard access was unavailable.')
  }
}

async function deleteCurrent() {
  if (!selectedStyle.value || !window.confirm(`Soft-delete “${selectedStyle.value.name}”?`)) return
  try {
    await api<void>(`/api/styles/${selectedStyle.value.id}`, { method: 'DELETE' })
    const removedId = selectedStyle.value.id
    selectedStyle.value = null
    selectedId.value = null
    await loadStyles()
    const next = styles.value.find((style) => style.id !== removedId)
    if (next) await selectStyle(next.id)
    tell('Style moved to trash.')
  } catch (caught) {
    error.value = caught instanceof Error ? caught.message : 'Could not delete style.'
  }
}

async function generateStyle() {
  if (!generationRequest.value.trim()) return
  generating.value = true
  error.value = ''
  try {
    const result = await api<{ positivePrompt: string; negativePrompt: string }>('/api/generate', {
      method: 'POST',
      body: JSON.stringify({ request: generationRequest.value }),
    })
    generatedHistory.value.unshift({ ...result, request: generationRequest.value })
  } catch (caught) {
    error.value = caught instanceof Error ? caught.message : 'Could not generate a style.'
  } finally {
    generating.value = false
  }
}

function useGenerated(result: GeneratedPrompt) {
  editorMode.value = 'new'
  draft.value = { name: '', positivePrompt: result.positivePrompt, negativePrompt: result.negativePrompt, source: 'generated' }
  generateDialog.value = false
  editorDialog.value = true
}
function openModelEdit() {
  if (!selectedStyle.value || !activeVersion.value) return
  modelEditInstruction.value = ''
  modelEditHistory.value = []
  modelEditDialog.value = true
}

async function editWithModel() {
  if (!activeVersion.value || !modelEditInstruction.value.trim()) return
  editingWithModel.value = true
  error.value = ''
  try {
    const result = await api<{ positivePrompt: string; negativePrompt: string }>('/api/edit-style', {
      method: 'POST',
      body: JSON.stringify({
        instruction: modelEditInstruction.value,
        positivePrompt: activeVersion.value.positivePrompt,
        negativePrompt: activeVersion.value.negativePrompt,
      }),
    })
    modelEditHistory.value.unshift({ ...result, request: modelEditInstruction.value })
  } catch (caught) {
    error.value = caught instanceof Error ? caught.message : 'Could not edit the style.'
  } finally {
    editingWithModel.value = false
  }
}

async function saveModelEdit(result: GeneratedPrompt) {
  if (!selectedStyle.value) return
  savingModelEdit.value = true
  error.value = ''
  try {
    const style = await api<StyleSummary>(`/api/styles/${selectedStyle.value.id}/versions`, {
      method: 'POST',
      body: JSON.stringify({
        name: selectedStyle.value.name,
        positivePrompt: result.positivePrompt,
        negativePrompt: result.negativePrompt,
        source: 'model-edit',
        metadata: { instruction: result.request },
      }),
    })
    modelEditDialog.value = false
    await loadStyles()
    await selectStyle(style.id)
    tell('Model edit saved as a new version.')
  } catch (caught) {
    error.value = caught instanceof Error ? caught.message : 'Could not save model edit.'
  } finally {
    savingModelEdit.value = false
  }
}

onMounted(async () => {
  try {
    await loadStyles(true)
  } catch (caught) {
    error.value = caught instanceof Error ? caught.message : 'Could not load your library.'
  } finally {
    loading.value = false
  }
})
</script>

<template>
  <v-app>
    <v-layout class="app-shell">
      <aside class="library-pane">
        <div class="brand-lockup">
          <div class="brand-mark"><v-icon icon="mdi-waveform" size="21" /></div>
          <div>
            <div class="brand-name">Styler</div>
            <div class="brand-caption">Suno prompt library</div>
          </div>
        </div>

        <div class="library-actions">
          <v-btn color="primary" prepend-icon="mdi-plus" block @click="openNewStyle">New style</v-btn>
          <v-btn variant="text" prepend-icon="mdi-tray-arrow-down" block @click="openImport">Import prompt</v-btn>
        </div>

        <div class="library-heading">
          <span>Styles</span>
          <span class="style-count">{{ styles.length }}</span>
        </div>

        <div v-if="loading" class="style-list">
          <v-skeleton-loader v-for="number in 5" :key="number" type="list-item-two-line" class="skeleton" />
        </div>
        <nav v-else class="style-list" aria-label="Saved styles">
          <button
            v-for="style in styles"
            :key="style.id"
            class="style-row"
            :class="{ active: style.id === selectedId }"
            type="button"
            @click="selectStyle(style.id)"
          >
            <span class="style-row-name">{{ style.name }}</span>
            <span class="style-row-meta">v{{ style.versionNumber }} · {{ formatDate(style.updatedAt) }}</span>
          </button>
          <div v-if="!styles.length" class="library-empty">No styles yet. Create one or import a prompt to start your library.</div>
        </nav>

        <div class="library-footer">
          <v-btn variant="text" size="small" prepend-icon="mdi-sparkles" @click="generateDialog = true">Generate a style</v-btn>
        </div>
      </aside>

      <main class="detail-pane">
        <template v-if="selectedStyle && activeVersion">
          <header class="detail-header">
            <div>
              <div class="section-label">Style</div>
              <h1>{{ selectedStyle.name }}</h1>
              <p>Version {{ activeVersion.versionNumber }} · {{ metadataFor(activeVersion) }} · updated {{ formatDate(activeVersion.createdAt) }}</p>
            </div>
            <div class="header-actions">
              <v-select v-model="selectedVersionId" :items="versionChoices" hide-details min-width="220" aria-label="Select version" />
              <v-btn variant="tonal" prepend-icon="mdi-pencil" @click="openVersionEditor">Edit as new version</v-btn>
              <v-btn variant="tonal" prepend-icon="mdi-auto-fix" @click="openModelEdit">Refine with model</v-btn>
              <v-btn icon="mdi-delete-outline" variant="text" aria-label="Delete style" @click="deleteCurrent" />
            </div>
          </header>

          <section class="prompt-section">
            <div class="prompt-heading">
              <div>
                <div class="section-label">Positive prompt</div>
                <p>Primary direction · {{ activeVersion.positivePrompt.length }}/{{ MAX_POSITIVE }}</p>
              </div>
              <v-btn variant="text" prepend-icon="mdi-content-copy" @click="copy(activeVersion.positivePrompt, 'Positive prompt')">Copy</v-btn>
            </div>
            <div class="prompt-content positive">{{ activeVersion.positivePrompt }}</div>
          </section>

          <section class="prompt-section negative-section">
            <div class="prompt-heading">
              <div>
                <div class="section-label">Negative prompt</div>
                <p>Exclude direction · {{ activeVersion.negativePrompt.length }}/{{ MAX_NEGATIVE }}</p>
              </div>
              <v-btn variant="text" prepend-icon="mdi-content-copy" @click="copy(activeVersion.negativePrompt, 'Negative prompt')">Copy</v-btn>
            </div>
            <div class="prompt-content negative">{{ activeVersion.negativePrompt || 'No exclusions set.' }}</div>
          </section>
        </template>

        <section v-else class="empty-detail">
          <div class="empty-glyph"><v-icon icon="mdi-waveform" size="44" /></div>
          <h1>Your prompt library starts here.</h1>
          <p>Save the sound directions you reach for, then keep each refinement as a version.</p>
          <div class="empty-actions">
            <v-btn color="primary" prepend-icon="mdi-plus" @click="openNewStyle">Create a style</v-btn>
            <v-btn variant="tonal" prepend-icon="mdi-sparkles" @click="generateDialog = true">Generate a style</v-btn>
          </div>
        </section>
      </main>
    </v-layout>

    <v-dialog v-model="importDialog" max-width="840" scrollable>
      <v-card class="dialog-card">
        <v-card-title>{{ importResult ? 'Review imported prompt' : 'Import a prompt' }}</v-card-title>
        <v-card-subtitle>{{ importResult ? 'Name it and check the split prompts before saving.' : 'Paste a combined prompt. Comma-separated terms beginning with a dash become negative exclusions.' }}</v-card-subtitle>
        <v-card-text>
          <template v-if="!importResult">
            <v-textarea v-model="importText" label="Combined prompt" rows="7" hint="Import separates the prompt into editable positive and negative fields." persistent-hint />
          </template>
          <template v-else>
            <v-btn size="small" variant="text" prepend-icon="mdi-arrow-left" class="mb-4" @click="importResult = null">Back to pasted prompt</v-btn>
            <v-text-field v-model="importName" label="Style name" maxlength="120" autofocus />
            <v-textarea v-model="importResult.positivePrompt" label="Positive prompt" :counter="MAX_POSITIVE" :maxlength="MAX_POSITIVE" rows="5" />
            <v-textarea v-model="importResult.negativePrompt" label="Negative prompt" :counter="MAX_NEGATIVE" :maxlength="MAX_NEGATIVE" rows="4" />
          </template>
        </v-card-text>
        <v-card-actions>
          <v-btn variant="text" @click="cancelImport">Cancel</v-btn><v-spacer />
          <v-btn v-if="!importResult" color="primary" :disabled="!importText.trim()" @click="parseImport">Import</v-btn>
          <v-btn v-else color="primary" :disabled="!importName.trim() || importResult.positivePrompt.length > MAX_POSITIVE || importResult.negativePrompt.length > MAX_NEGATIVE" @click="saveImported">Save style</v-btn>
        </v-card-actions>
      </v-card>
    </v-dialog>

    <v-dialog v-model="editorDialog" max-width="800" persistent>
      <v-card class="dialog-card">
        <v-card-title>{{ editorMode === 'new' ? 'Create style' : `Version ${activeVersion?.versionNumber ? activeVersion.versionNumber + 1 : ''}` }}</v-card-title>
        <v-card-subtitle>{{ editorMode === 'new' ? 'Build a reusable direction for your next Suno session.' : 'Your edit is saved as a new version; existing versions remain intact.' }}</v-card-subtitle>
        <v-card-text>
          <v-text-field v-model="draft.name" label="Style name" maxlength="120" autofocus />
          <v-textarea v-model="draft.positivePrompt" label="Positive prompt" :counter="MAX_POSITIVE" :maxlength="MAX_POSITIVE" rows="5" hint="Start with the central genre and mood, then add vocals, instruments, arrangement, and mix." persistent-hint />
          <v-textarea v-model="draft.negativePrompt" label="Negative prompt" :counter="MAX_NEGATIVE" :maxlength="MAX_NEGATIVE" rows="3" hint="Keep exclusions short and specific." persistent-hint />
        </v-card-text>
        <v-card-actions>
          <v-btn variant="text" :disabled="saving" @click="editorDialog = false">Cancel</v-btn><v-spacer />
          <v-btn color="primary" :loading="saving" :disabled="draft.positivePrompt.length > MAX_POSITIVE || draft.negativePrompt.length > MAX_NEGATIVE" @click="saveDraft">{{ editorMode === 'new' ? 'Save style' : 'Save version' }}</v-btn>
        </v-card-actions>
      </v-card>
    </v-dialog>

    <v-dialog v-model="generateDialog" max-width="900" scrollable>
      <v-card class="dialog-card generation-dialog">
        <v-card-title>Generate a style</v-card-title>
        <v-card-subtitle>Describe the sound you need. Styler asks OpenRouter for an original Suno-ready positive and negative prompt.</v-card-subtitle>
        <v-card-text>
          <v-textarea v-model="generationRequest" label="What should this style sound like?" rows="4" placeholder="e.g. A volatile midnight dance track that begins intimate and breaks open into catharsis" />
          <div class="dialog-actions-row"><span class="generation-note">Uses {{ generatedHistory.length ? 'reroll to explore another direction' : 'your configured OpenRouter model' }}.</span><v-spacer /><v-btn color="primary" prepend-icon="mdi-dice-5" :loading="generating" :disabled="!generationRequest.trim()" @click="generateStyle">{{ generatedHistory.length ? 'Reroll' : 'Generate' }}</v-btn></div>
          <div v-if="generatedHistory.length" class="history-list">
            <article v-for="(result, index) in generatedHistory" :key="`${result.request}-${index}`" class="generation-result">
              <div class="generation-result-header"><span>Result {{ generatedHistory.length - index }}</span><v-btn size="small" variant="tonal" prepend-icon="mdi-arrow-right" @click="useGenerated(result)">Use this</v-btn></div>
              <div class="generated-block"><span>Positive</span><p>{{ result.positivePrompt }}</p></div>
              <div class="generated-block negative-block"><span>Negative</span><p>{{ result.negativePrompt }}</p></div>
            </article>
          </div>
        </v-card-text>
        <v-card-actions><v-btn variant="text" @click="generateDialog = false">Done</v-btn></v-card-actions>
      </v-card>
    </v-dialog>

    <v-dialog v-model="modelEditDialog" max-width="900" scrollable>
      <v-card class="dialog-card generation-dialog">
        <v-card-title>Refine with model</v-card-title>
        <v-card-subtitle>Describe the change you need. The current version is preserved until you save a result as a new version.</v-card-subtitle>
        <v-card-text>
          <div v-if="activeVersion" class="model-edit-context">
            <div class="model-edit-context-header">Editing version {{ activeVersion.versionNumber }}</div>
            <div class="model-edit-context-label">Current positive prompt</div>
            <p>{{ activeVersion.positivePrompt }}</p>
            <div class="model-edit-context-label">Current negative prompt</div>
            <p>{{ activeVersion.negativePrompt || 'No exclusions set.' }}</p>
          </div>
          <v-textarea v-model="modelEditInstruction" label="What should change?" rows="4" placeholder="e.g. Make the vocal delivery more urgent, keep the cinematic buildup, and remove any artist references." />
          <div class="dialog-actions-row">
            <span class="generation-note">Uses {{ modelEditHistory.length ? 'reroll to explore another revision' : 'the current version as context' }}.</span>
            <v-spacer />
            <v-btn color="primary" prepend-icon="mdi-dice-5" :loading="editingWithModel" :disabled="!modelEditInstruction.trim()" @click="editWithModel">{{ modelEditHistory.length ? 'Reroll' : 'Refine' }}</v-btn>
          </div>
          <div v-if="modelEditHistory.length" class="history-list">
            <article v-for="(result, index) in modelEditHistory" :key="`${result.request}-${index}`" class="generation-result">
              <div class="generation-result-header">
                <span>Revision {{ modelEditHistory.length - index }}</span>
                <v-btn size="small" color="primary" variant="tonal" prepend-icon="mdi-content-save-outline" :loading="savingModelEdit" @click="saveModelEdit(result)">Save as version</v-btn>
              </div>
              <div class="generated-block"><span>Positive</span><p>{{ result.positivePrompt }}</p></div>
              <div class="generated-block negative-block"><span>Negative</span><p>{{ result.negativePrompt }}</p></div>
            </article>
          </div>
        </v-card-text>
        <v-card-actions><v-btn variant="text" :disabled="savingModelEdit" @click="modelEditDialog = false">Cancel</v-btn></v-card-actions>
      </v-card>
    </v-dialog>

    <v-snackbar v-model="snackbar" color="surface-bright" location="bottom right">{{ snackbarText }}</v-snackbar>
    <v-snackbar :model-value="Boolean(error)" color="error" location="bottom right" timeout="6000" @update:model-value="(value) => { if (!value) error = '' }">{{ error }}</v-snackbar>
  </v-app>
</template>
